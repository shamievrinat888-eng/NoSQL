<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com" xmlns:fx="http://fxml.com" fx:controller="kz.atu.lab06.CatalogController">
    <top>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Label text="Каталог смартфонов">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <children>
                        <TextField fx:id="txtSearch" promptText="Поиск по модели..." HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="cmbFilterBrand" promptText="Фильтр по бренду" prefWidth="150.0" />
                        <Button onAction="#onClearFilterClick" text="Очистить фильтр" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <left>
        <VBox spacing="5.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="5.0" top="10.0" />
            </padding>
            <children>
                <Label text="Бренды (Быстрый фильтр):" />
                <ListView fx:id="listBrands" prefWidth="180.0" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </left>
    <center>
        <TableView fx:id="tableSmartphones" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colBrand" prefWidth="120.0" text="Бренд" />
                <TableColumn fx:id="colModel" prefWidth="180.0" text="Модель" />
                <TableColumn fx:id="colMemory" prefWidth="100.0" text="Память (ГБ)" />
                <TableColumn fx:id="colPrice" prefWidth="120.0" text="Цена (тг)" />
            </columns>
            <BorderPane.margin>
                <Insets bottom="10.0" left="5.0" right="10.0" top="10.0" />
            </BorderPane.margin>
        </TableView>
    </center>
    <bottom>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="5.0" />
            </padding>
            <children>
                <TitledPane animated="false" collapsible="false" text="Управление элементами">
                    <content>
                        <GridPane hgap="10.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="Бренд:" />
                                <ComboBox fx:id="cmbBrand" prefWidth="200.0" GridPane.columnIndex="1" />
                                <Label text="Модель:" GridPane.rowIndex="1" />
                                <TextField fx:id="txtModel" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label text="Память (ГБ):" GridPane.columnIndex="2" />
                                <TextField fx:id="txtMemory" GridPane.columnIndex="3" />
                                <Label text="Цена:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <TextField fx:id="txtPrice" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                            </children>
                        </GridPane>
                    </content>
                </TitledPane>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <children>
                        <Button onAction="#onAddClick" text="Добавить" prefWidth="100.0" />
                        <Button onAction="#onDeleteClick" text="Удалить выбранное" prefWidth="150.0" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblCount" text="Найдено записей: 0" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </bottom>
</BorderPane>