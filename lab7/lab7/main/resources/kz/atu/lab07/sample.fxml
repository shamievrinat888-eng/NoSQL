<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com" xmlns:fx="http://javafx.com"
            fx:controller="kz.atu.lab07.EditorController">
    <top>
        <VBox>
            <!-- Главное меню -->
            <MenuBar>
                <Menu text="Файл">
                    <MenuItem fx:id="miNew" text="Новый" onAction="#onNew"/>
                    <MenuItem fx:id="miOpen" text="Открыть" onAction="#onOpen"/>
                    <MenuItem fx:id="miSave" text="Сохранить" onAction="#onSave"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Выход" onAction="#onExit"/>
                </Menu>
                <Menu text="Правка">
                    <MenuItem text="Вырезать" onAction="#onCut"/>
                    <MenuItem text="Копировать" onAction="#onCopy"/>
                    <MenuItem text="Вставить" onAction="#onPaste"/>
                </Menu>
                <Menu text="Справка">
                    <MenuItem text="О программе" onAction="#onAbout"/>
                </Menu>
            </MenuBar>

            <!-- Панель инструментов -->
            <ToolBar>
                <Button text="Новый" onAction="#onNew"/>
                <Button text="Открыть" onAction="#onOpen"/>
                <Button text="Сохранить" onAction="#onSave"/>
                <Button text="Копировать" onAction="#onCopy"/>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <!-- Текстовое поле с контекстным меню -->
        <TextArea fx:id="txtEditor">
            <contextMenu>
                <ContextMenu>
                    <items>
                        <MenuItem text="Вырезать" onAction="#onCut"/>
                        <MenuItem text="Копировать" onAction="#onCopy"/>
                        <MenuItem text="Вставить" onAction="#onPaste"/>
                    </items>
                </ContextMenu>
            </contextMenu>
        </TextArea>
    </center>

    <bottom>
        <!-- Строка состояния -->
        <HBox spacing="10" style="-fx-padding: 5px;">
            <Label fx:id="lblStatus" text="Символов: 0"/>
        </HBox>
    </bottom>
</BorderPane>
